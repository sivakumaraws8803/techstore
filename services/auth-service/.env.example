NODE_ENV=production
PORT=3001

# Use the same TechStore PostgreSQL database during the migration.
# Keep this service's database credentials in its own .env file.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=techstore
DB_USER=techstore_app
DB_PASSWORD=CHANGE_ME

# Generate a long random value; do not reuse SESSION_SECRET from Git.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
