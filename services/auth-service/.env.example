NODE_ENV=production
PORT=3001
COOKIE_SECURE=false

# Reuse the current TechStore PostgreSQL database during migration.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=techstore
DB_USER=techstore_app
DB_PASSWORD=CHANGE_ME

# During migration, copy the existing backend SESSION_SECRET to preserve sessions.
SESSION_SECRET=CHANGE_ME_TO_A_SECRET_OF_AT_LEAST_32_CHARACTERS
